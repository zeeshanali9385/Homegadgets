{%- if section.blocks.size > 0 -%}
  <style>
    :root {
      --announcement-bar-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};

      {%- if section.index == 1 and section.settings.enable_sticky == false -%}
        --header-scroll-tracker-offset: var(--announcement-bar-height);
      {%- endif -%}
    }

    {%- if section.settings.enable_sticky -%}
      #shopify-section-{{ section.id }} {
        position: sticky;
        top: 0;
        z-index: 5;
      }

      .shopify-section--header ~ #shopify-section-{{ section.id }} {
        top: calc(var(--header-is-sticky, 0) * var(--header-height, 0px));
        z-index: 4; /* We have to lower the z-index in case the announcement bar is displayed after the header */
      }
    {%- endif -%}

    #shopify-section-{{ section.id }} {
      --announcement-bar-font-size: {{ section.settings.mobile_font_size | divided_by: 16.0 }}rem;
      --announcement-bar-font-weight: {{ section.settings.font_weight }};
      --announcement-bar-padding-vertical: {{ section.settings.mobile_padding_vertical }}px;
    }

    /* Apply vertical padding to the announcement bar */
    #shopify-section-{{ section.id }} .announcement-bar {
      padding-top: var(--announcement-bar-padding-vertical);
      padding-bottom: var(--announcement-bar-padding-vertical);
    }

    /* Apply font weight to announcement text */
    #shopify-section-{{ section.id }} .announcement-bar__carousel .prose {
      font-weight: var(--announcement-bar-font-weight) !important;
    }

    /* Desktop/Mobile Text Display Control */
    #shopify-section-{{ section.id }} .announcement-desktop-text {
      display: none;
    }
    
    #shopify-section-{{ section.id }} .announcement-mobile-text {
      display: block;
    }

    /* Hide arrows on mobile if setting is disabled */
    {%- unless section.settings.show_arrows_mobile -%}
      @media screen and (max-width: 998px) {
        #shopify-section-{{ section.id }} .tap-area {
          display: none !important;
        }
        
        #shopify-section-{{ section.id }} .announcement-bar__carousel {
          padding: 0 1rem;
          width: 100%;
        }
      }
    {%- endunless -%}

    @media screen and (min-width: 999px) {
      #shopify-section-{{ section.id }} {
        --announcement-bar-font-size: {{ section.settings.desktop_font_size | divided_by: 16.0 }}rem;
        --announcement-bar-padding-vertical: {{ section.settings.desktop_padding_vertical }}px;
      }

      /* Show desktop text, hide mobile text on desktop */
      #shopify-section-{{ section.id }} .announcement-desktop-text {
        display: block;
      }
      
      #shopify-section-{{ section.id }} .announcement-mobile-text {
        display: none;
      }
    }
  </style>

  <height-observer variable="announcement-bar">
    <div class="announcement-bar color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
      {%- assign carousel_id = 'carousel-' | append: section.id -%}

      {%- if section.blocks.size > 1 -%}
        <button type="button" is="carousel-prev-button" class="tap-area" aria-controls="{{ carousel_id }}">
          <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
          {%- render 'icon' with 'arrow-left', width: 12, direction_aware: true -%}
        </button>
      {%- endif -%}

      <announcement-bar-carousel allow-swipe {% if section.settings.autoplay %}autoplay="{{ section.settings.cycle_speed }}"{% endif %} id="{{ carousel_id }}" class="announcement-bar__carousel">
        {%- for block in section.blocks -%}
          {%- comment -%}Determine if we have separate mobile/desktop text{%- endcomment -%}
          {%- assign has_mobile_text = false -%}
          {%- if block.settings.mobile_text and block.settings.mobile_text != blank and block.settings.mobile_text != '<p>Announce something here</p>' -%}
            {%- assign has_mobile_text = true -%}
          {%- endif -%}
          
          {%- assign has_desktop_text = false -%}
          {%- if block.settings.desktop_text and block.settings.desktop_text != blank -%}
            {%- assign has_desktop_text = true -%}
          {%- endif -%}
          
          {%- if has_mobile_text or has_desktop_text -%}
            {%- comment -%}Container div for both mobile and desktop versions{%- endcomment -%}
            <div class="prose heading announcement-item {% if forloop.first %}is-selected{% endif %}" {{ block.shopify_attributes }}>
              {%- comment -%}Desktop text{%- endcomment -%}
              <span class="announcement-desktop-text">
                {%- if has_desktop_text -%}
                  {{- block.settings.desktop_text -}}
                {%- else -%}
                  {{- block.settings.text -}}
                {%- endif -%}
              </span>
              
              {%- comment -%}Mobile text{%- endcomment -%}
              <span class="announcement-mobile-text">
                {%- if has_mobile_text -%}
                  {{- block.settings.mobile_text -}}
                {%- else -%}
                  {%- if has_desktop_text -%}
                    {{- block.settings.desktop_text -}}
                  {%- else -%}
                    {{- block.settings.text -}}
                  {%- endif -%}
                {%- endif -%}
              </span>
            </div>
          {%- else -%}
            {%- comment -%}Use single text for both desktop and mobile (legacy behavior){%- endcomment -%}
            <p class="prose heading {% if forloop.first %}is-selected{% endif %}" {{ block.shopify_attributes }}>
              {{- block.settings.text -}}
            </p>
          {%- endif -%}
        {%- endfor -%}
      </announcement-bar-carousel>

      {%- if section.blocks.size > 1 -%}
        <button type="button" is="carousel-next-button" class="tap-area" aria-controls="{{ carousel_id }}">
          <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
          {%- render 'icon' with 'arrow-right', width: 12, direction_aware: true -%}
        </button>
      {%- endif -%}
    </div>
  </height-observer>

  <script>
    document.documentElement.style.setProperty('--announcement-bar-height', `${Math.round(document.getElementById('shopify-section-{{ section.id }}').clientHeight)}px`);
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "shopify-section--announcement-bar",
  "tag": "aside",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.blocks.message.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Announcement text (All devices)",
          "default": "Announce something here",
          "info": "This text will be used on all devices unless you specify separate mobile/desktop text below"
        },
        {
          "type": "header",
          "content": "Separate Mobile/Desktop Text (Optional)"
        },
        {
          "type": "paragraph",
          "content": "Use these fields to display different text on mobile and desktop. Leave empty to use the main announcement text above."
        },
        {
          "type": "inline_richtext",
          "id": "desktop_text",
          "label": "Desktop-only text",
          "info": "Text that will only show on desktop screens (999px and wider). If empty, uses the main announcement text."
        },
        {
          "type": "richtext",
          "id": "mobile_text",
          "label": "Mobile-only text",
          "info": "Text that will only show on mobile screens (998px and narrower). Supports line breaks and HTML formatting."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.announcement_bar.enable_sticky_bar"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.announcement_bar.auto_rotate_between_messages",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "sec",
      "label": "t:sections.announcement_bar.cycle_speed",
      "default": 5
    },
    {
      "type": "header",
      "content": "Spacing Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_vertical",
      "min": 2,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Desktop vertical padding",
      "default": 12,
      "info": "Controls the top and bottom padding on desktop"
    },
    {
      "type": "range",
      "id": "mobile_padding_vertical",
      "min": 2,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Mobile vertical padding",
      "default": 10,
      "info": "Controls the top and bottom padding on mobile"
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "min": 9,
      "max": 20,
      "unit": "px",
      "label": "Desktop text size",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 9,
      "max": 18,
      "unit": "px",
      "label": "Mobile text size",
      "default": 10
    },
    {
      "type": "range",
      "id": "font_weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "Font weight (boldness)",
      "default": 400,
      "info": "100 = Thin, 400 = Normal, 700 = Bold, 900 = Extra Bold"
    },
    {
      "type": "header",
      "content": "Display Settings"
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "Show navigation arrows on mobile",
      "default": false,
      "info": "Hide arrows on mobile to maximize text display space"
    }
  ]
}
{% endschema %}