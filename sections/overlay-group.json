        "tier_1": {
          "type": "tier",
          "settings": {
            "threshold": 2,
            "reward": "EXTRA 10% discount",
            "badge_text": "EXTRA 10% OFF",
            "label": "10% OFF"
          }
        },
        "tier_2": {
          "type": "tier",
          "settings": {
            "threshold": 3,
            "reward": "EXTRA 15% discount",
            "badge_text": "EXTRA 15% OFF",
            "label": "15% OFF"
          }
        },
        "tier_3": {
          "type": "tier",
          "settings": {
            "threshold": 4,
            "reward": "EXTRA 20% discount",
            "badge_text": "EXTRA 20% OFF",
            "label": "20% OFF"
          }
        }
      },
      "block_order": [
        "tier_1",
        "tier_2",
        "tier_3"
      ],
      "settings": {
        "color_scheme": "",
        "logo": "shopify://shop_images/010fcbf6-b0c9-488b-ad4d-72bd3b30705e.png",
        "logo_height": 66,
        "logo_subtitle": "",
        "close_bg": "#f2f2f2",
        "show_announcement": true,
        "announcement_text": "CLEARANCE SALE ENDS TONIGHT AT 11:59 PM",
