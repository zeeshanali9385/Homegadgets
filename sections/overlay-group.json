        "show_only_once": true,
        "title": "Signup for our newsletter",
        "content": "Describe what your customers will receive when subscribing to your newsletter.",
        "button_text": "Subscribe"
      }
    },
    "privacy-banner": {
      "type": "privacy-banner",
      "disabled": true,
      "settings": {
        "color_scheme": "",
        "title": "🍪 Cookie policy",
        "content": "<p>We use cookies and similar technologies to provide the best experience on our website. Refer to our Privacy Policy for more information.</p>"
