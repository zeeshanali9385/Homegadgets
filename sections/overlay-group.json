        "savings_color": "#22b16b",
        "show_discounts": true,
        "discounts_label": "Discounts",
        "use_tier_badge": true,
        "badge_bg": "#f1f1f1",
        "checkout_label": "Checkout",
        "show_checkout_button": true,
        "show_price_in_checkout_button": true,
        "show_view_cart_button": false,
        "button_radius": 0,
        "show_payment_icons": true,
        "payment_icons": "visa,master,discover,american_express,apple_pay,google_pay",
        "show_cart_note": false,
        "show_shipping_text": false,
        "empty_text": "Your cart is empty",
        "empty_button_label": "Continue shopping",
        "empty_button_link": "",
        "drawer_font": "jost_n4",
        "text_color": "#000000",
        "muted_color": "#9b9b9b",
        "border_color": "#e3e3e3",
        "accent_color": "#000000",
        "accent_text_color": "#ffffff",
        "cross_sell_products": [],
        "cross_sell_title": "Complete Your Look:",
        "cross_sell_stack_products": false
