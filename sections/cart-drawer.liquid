{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "class": "shopify-section--cart-drawer",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    { "type": "paragraph", "content": "t:sections.cart_drawer.page_info" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:global.colors.scheme", "default": "scheme-1" },
    { "type": "header", "content": "Header" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 20, "max": 120, "step": 2, "unit": "px", "default": 32 },
    { "type": "text", "id": "logo_subtitle", "label": "Subtitle under store name", "info": "Only shows when no logo image is set." },
    { "type": "color", "id": "close_bg", "label": "Close button background", "default": "#f2f2f2" },
    { "type": "header", "content": "Announcement bar" },
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "announcement_text", "label": "Text", "default": "CLEARANCE SALE ENDS TONIGHT AT 11:59 PM" },
    { "type": "color", "id": "announcement_bg", "label": "Background", "default": "#efefef" },
    { "type": "color", "id": "announcement_text_color", "label": "Text color", "default": "#000000" },
    { "type": "color", "id": "announcement_border", "label": "Border color", "default": "#cfcfcf" },
    { "type": "header", "content": "Rewards progress bar", "info": "Add one Tier block per discount, lowest first. Create the matching automatic discounts in Shopify admin > Discounts." },
    { "type": "checkbox", "id": "show_rewards", "label": "Show rewards progress bar", "default": true },
    { "type": "select", "id": "tier_basis", "label": "Tiers are based on", "options": [ { "value": "quantity", "label": "Number of items" }, { "value": "subtotal", "label": "Cart subtotal" } ], "default": "quantity" },
    { "type": "text", "id": "progress_message", "label": "Progress message", "info": "Use [remaining] and [reward].", "default": "You're [remaining] away from an [reward]!" },
    { "type": "text", "id": "complete_message", "label": "All tiers unlocked message", "info": "Use [reward].", "default": "Congrats! You've unlocked an [reward]!" },
    { "type": "text", "id": "unit_singular", "label": "Item word (singular)", "default": "product" },
    { "type": "text", "id": "unit_plural", "label": "Item word (plural)", "default": "products" },
    { "type": "checkbox", "id": "show_tier_labels", "label": "Show labels under icons", "default": false },
    { "type": "color", "id": "track_color", "label": "Bar background", "default": "#e3e3e3" },
    { "type": "header", "content": "Products" },
    { "type": "checkbox", "id": "show_variant_options", "label": "Show variant options", "default": true },
    { "type": "checkbox", "id": "show_savings", "label": "Show savings", "default": true },
    { "type": "text", "id": "savings_text", "label": "Savings text", "info": "Use [amount].", "default": "(Save [amount])" },
    { "type": "color", "id": "savings_color", "label": "Savings color", "default": "#22b16b" },
    { "type": "header", "content": "Footer" },
    { "type": "checkbox", "id": "show_discounts", "label": "Show discounts row", "default": true },
    { "type": "text", "id": "discounts_label", "label": "Discounts label", "default": "Discounts" },
    { "type": "checkbox", "id": "use_tier_badge", "label": "Use tier badge text instead of discount name", "default": true },
    { "type": "color", "id": "badge_bg", "label": "Discount badge background", "default": "#f1f1f1" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button text", "default": "Checkout" },
    { "type": "checkbox", "id": "show_checkout_button", "label": "t:sections.cart_drawer.show_checkout_button", "default": true },
    { "type": "checkbox", "id": "show_price_in_checkout_button", "label": "t:sections.cart_drawer.show_price_in_checkout_button", "default": true },
    { "type": "checkbox", "id": "show_view_cart_button", "label": "t:sections.cart_drawer.show_view_cart_button", "default": false },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "payment_icons", "label": "Payment icons to show", "info": "Comma separated, in order: visa, master, discover, american_express, apple_pay, google_pay, paypal, shopify_pay, klarna, maestro. Leave empty to show all methods enabled in your store.", "default": "visa,master,discover,american_express,apple_pay,google_pay" },
    { "type": "checkbox", "id": "show_cart_note", "label": "t:sections.cart_drawer.show_cart_note", "default": false },
    { "type": "checkbox", "id": "show_shipping_text", "label": "t:sections.cart_drawer.show_shipping_text", "default": false },
    { "type": "header", "content": "Empty cart" },
    { "type": "text", "id": "empty_text", "label": "Empty cart text", "default": "Your cart is empty" },
    { "type": "text", "id": "empty_button_label", "label": "Button text", "default": "Continue shopping" },
    { "type": "url", "id": "empty_button_link", "label": "Button link" },
    { "type": "header", "content": "Font and colors" },
    { "type": "font_picker", "id": "drawer_font", "label": "Font", "default": "jost_n4" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "muted_color", "label": "Secondary text", "default": "#9b9b9b" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#e3e3e3" },
    { "type": "color", "id": "accent_color", "label": "Accent (button, progress)", "default": "#000000" },
    { "type": "color", "id": "accent_text_color", "label": "Accent text", "default": "#ffffff" },
    { "type": "header", "content": "t:sections.cart_drawer.cross_sell_category" },
    { "type": "product_list", "id": "cross_sell_products", "label": "t:sections.cart_drawer.cross_sell_products", "info": "t:sections.cart_drawer.cross_sell_products_info", "limit": 5 },
    { "type": "inline_richtext", "id": "cross_sell_title", "label": "t:sections.cart_drawer.cross_sell_heading", "default": "Complete with" },
    { "type": "checkbox", "id": "cross_sell_stack_products", "label": "t:sections.cart_drawer.cross_sell_stack_products", "default": false }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "number", "id": "threshold", "label": "Unlocks at", "info": "Number of items, or cart subtotal in store currency, depending on the section setting.", "default": 2 },
        { "type": "text", "id": "reward", "label": "Reward text in message", "default": "EXTRA 10% discount" },
        { "type": "text", "id": "badge_text", "label": "Discount badge text", "default": "EXTRA 10% OFF" },
        { "type": "text", "id": "label", "label": "Label under icon", "default": "10% OFF" }
      ]
    }
  ]
}
{% endschema %}
