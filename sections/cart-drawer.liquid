{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
CART DRAWER (custom rewards layout) - Nomtech
Everything is editable in the theme editor: Theme settings > Overlay group > Cart drawer.
Tier blocks drive the progress bar; the discounts themselves must exist in Shopify admin > Discounts.
----------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign ka_font = s.drawer_font
  assign ka_font_bold = ka_font | font_modify: 'weight', '600'
  if ka_font_bold == nil
    assign ka_font_bold = ka_font | font_modify: 'weight', 'bolder'
  endif

  assign tiers = section.blocks | where: 'type', 'tier'
  assign tier_count = tiers.size

  if s.tier_basis == 'subtotal'
    assign ka_value = cart.items_subtotal_price
  else
    assign ka_value = cart.item_count
  endif

  assign reached = 0
  assign seg_start = 0
  assign seg_end = 0
  assign next_found = false
  assign next_tier = nil
  assign last_tier = nil

  for tier in tiers
    assign t = tier.settings.threshold | default: 0
    if s.tier_basis == 'subtotal'
      assign t = t | times: 100
    endif

    if ka_value >= t
      assign reached = reached | plus: 1
      assign seg_start = t
      assign last_tier = tier
    elsif next_found == false
      assign next_found = true
      assign seg_end = t
      assign next_tier = tier
    endif
  endfor

  assign fill = 0
  if tier_count > 0
    if next_found
      assign seg_range = seg_end | minus: seg_start
      assign seg_done = ka_value | minus: seg_start
      assign frac = 0
      if seg_range > 0
        assign frac = seg_done | times: 1.0 | divided_by: seg_range
      endif
      assign fill = frac | plus: reached | times: 100.0 | divided_by: tier_count
    else
      assign fill = 100
    endif
  endif

  if next_found
    assign remaining = seg_end | minus: ka_value
    if s.tier_basis == 'subtotal'
      assign remaining_text = remaining | money
    else
      if remaining == 1
        assign remaining_text = remaining | append: ' ' | append: s.unit_singular
      else
        assign remaining_text = remaining | append: ' ' | append: s.unit_plural
      endif
    endif
    assign rewards_message = s.progress_message | replace: '[remaining]', remaining_text | replace: '[reward]', next_tier.settings.reward
  elsif last_tier != nil
    assign rewards_message = s.complete_message | replace: '[reward]', last_tier.settings.reward
  endif
-%}

{%- style -%}
  {{ ka_font | font_face: font_display: 'swap' }}
  {%- if ka_font_bold != nil -%}{{ ka_font_bold | font_face: font_display: 'swap' }}{%- endif -%}

  #cart-drawer.ka-cart {
    --ka-gutter: 24px;
    --ka-dot: 38px;
    --ka-brand-h: {{ s.logo_height | plus: 28 }}px;
    --ka-text: {{ s.text_color }};
    --ka-muted: {{ s.muted_color }};
    --ka-border: {{ s.border_color }};
    --ka-accent: {{ s.accent_color }};
    --ka-accent-text: {{ s.accent_text_color }};
    --ka-track: {{ s.track_color }};
    --ka-save: {{ s.savings_color }};
    --ka-badge-bg: {{ s.badge_bg }};
    --ka-close-bg: {{ s.close_bg }};
    --ka-ann-bg: {{ s.announcement_bg }};
    --ka-ann-text: {{ s.announcement_text_color }};
    --ka-ann-border: {{ s.announcement_border }};
    --ka-font: {{ ka_font.family }}, {{ ka_font.fallback_families }};
    color: var(--ka-text);
  }

  #cart-drawer.ka-cart::part(header) {
    display: block;
    position: relative;
    padding: 0;
    border: 0;
    gap: 0;
  }

  #cart-drawer.ka-cart::part(close-button) {
    position: absolute;
    top: calc((var(--ka-brand-h) - 32px) / 2);
    right: 20px;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    margin: 0;
    background: var(--ka-close-bg);
    color: var(--ka-text);
    border-radius: 4px;
    z-index: 2;
  }

  #cart-drawer.ka-cart::part(body) {
    padding: 0;
  }

  #cart-drawer.ka-cart::part(footer) {
    padding: 0;
    border-top: 1px solid var(--ka-border);
  }

  .ka-cart,
  .ka-cart__header,
  .ka-cart__items,
  .ka-cart__footer,
  .ka-cart__empty,
  .ka-cart__error {
    font-family: var(--ka-font);
    font-weight: {{ ka_font.weight }};
    font-style: normal;
    letter-spacing: normal;
    text-transform: none;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  :where(.ka-cart) :where(p, span, a, li, button, input, div) {
    font-family: inherit;
  }

  :where(.ka-cart) :where(button, input) {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  .ka-cart__brand {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--ka-brand-h);
    padding: 0 64px;
    text-align: center;
  }

  .ka-cart__brand img {
    display: block;
    height: {{ s.logo_height }}px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .ka-cart__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .ka-cart__brand-name {
    font-size: 22px;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .ka-cart__brand-sub {
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  .ka-cart__announcement {
    background: var(--ka-ann-bg);
    color: var(--ka-ann-text);
    border-top: 1px solid var(--ka-ann-border);
    border-bottom: 1px solid var(--ka-ann-border);
    padding: 5px var(--ka-gutter);
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: .03em;
    text-align: center;
    text-transform: uppercase;
  }

  .ka-rewards {
    padding: 22px var(--ka-gutter) 26px;
  }

  .ka-rewards__message {
    margin: 0 0 14px;
    font-size: 14px;
    line-height: 1.35;
    text-align: center;
  }

  .ka-rewards__track {
    position: relative;
    height: var(--ka-dot);
  }

  .ka-rewards__track.has-labels {
    margin-bottom: 20px;
  }

  .ka-rewards__rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 9px;
    transform: translateY(-50%);
    background: var(--ka-track);
    border-radius: 99px;
    overflow: hidden;
  }

  .ka-rewards__fill {
    height: 100%;
    background: var(--ka-accent);
    border-radius: 99px;
    transition: width .35s ease;
  }

  .ka-rewards__dot {
    position: absolute;
    top: 50%;
    width: var(--ka-dot);
    height: var(--ka-dot);
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid var(--ka-accent);
    background: var(--ka-track);
    color: var(--ka-accent);
    box-sizing: border-box;
  }

  .ka-rewards__dot.is-reached {
    background: var(--ka-accent);
    color: var(--ka-accent-text);
  }

  .ka-rewards__dot svg {
    width: 17px;
    height: 17px;
    transform: rotate(90deg);
  }

  .ka-rewards__label {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 11px;
    color: var(--ka-text);
  }

  .ka-item {
    transition: opacity .2s ease;
  }

  .ka-item.is-removing {
    opacity: 0;
    pointer-events: none;
  }

  .ka-cart.ka-is-syncing .ka-cart__discount-amount,
  .ka-cart.ka-is-syncing .ka-cart__btn-total,
  .ka-cart.ka-is-syncing .ka-rewards,
  .ka-cart.ka-is-adding .ka-cart__discount-amount,
  .ka-cart.ka-is-adding .ka-cart__btn-total,
  .ka-cart.ka-is-adding .ka-rewards {
    opacity: .45;
    transition: opacity .15s ease;
  }

  .ka-cart.ka-is-syncing button[name="checkout"],
  .ka-cart.ka-is-adding button[name="checkout"] {
    pointer-events: none;
  }

  .ka-skeleton {
    display: grid;
    grid-template-columns: 86px 1fr;
    gap: 20px;
    padding: 4px var(--ka-gutter) 24px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--ka-border);
  }

  .ka-sk {
    display: block;
    height: 12px;
    border-radius: 3px;
    background: linear-gradient(90deg, #ececec 25%, #f7f7f7 50%, #ececec 75%);
    background-size: 200% 100%;
    animation: ka-shimmer 1.1s linear infinite;
  }

  .ka-sk--img {
    width: 86px;
    height: 86px;
    border-radius: 0;
  }

  .ka-sk-lines {
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 3px;
  }

  .ka-sk-lines .ka-sk:first-child {
    width: 85%;
    height: 15px;
  }

  .ka-sk--short {
    width: 45%;
  }

  .ka-sk--qty {
    width: 102px;
    height: 30px;
    margin-top: 6px;
  }

  @keyframes ka-shimmer {
    from { background-position: 200% 0; }
    to { background-position: -200% 0; }
  }

  .ka-cart__error {
    margin: 0 var(--ka-gutter) 12px;
    padding: 8px 12px;
    font-size: 13px;
    color: #b42318;
    background: #fef3f2;
    border-radius: 4px;
  }

  .ka-item {
    display: grid;
    grid-template-columns: 86px 1fr;
    gap: 20px;
    padding: 4px var(--ka-gutter) 24px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--ka-border);
  }

  .ka-item__media {
    display: block;
    width: 86px;
    height: 86px;
    overflow: hidden;
  }

  .ka-item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ka-item__info {
    min-width: 0;
  }

  .ka-item__top {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ka-item__title {
    flex: 1;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ka-text);
    text-decoration: none;
  }

  .ka-item__remove {
    flex: none;
    padding: 0;
    margin-top: -1px;
    background: none;
    border: 0;
    color: var(--ka-muted);
    cursor: pointer;
    line-height: 0;
  }

  .ka-item__remove:hover {
    color: var(--ka-text);
  }

  .ka-item__meta {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    line-height: 1.75;
    color: var(--ka-muted);
  }

  .ka-item__bottom {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
  }

  .ka-qty {
    display: inline-flex;
    height: 30px;
    border: 1px solid var(--ka-border);
  }

  .ka-qty__btn {
    width: 28px;
    display: grid;
    place-items: center;
    padding: 0;
    background: none;
    border: 0;
    color: var(--ka-text);
    cursor: pointer;
    font-size: 15px;
    line-height: 1;
  }

  .ka-qty__btn[disabled] {
    opacity: .35;
    cursor: not-allowed;
  }

  .ka-qty__input {
    width: 44px;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    border-left: 1px solid var(--ka-border);
    border-right: 1px solid var(--ka-border);
    border-radius: 0;
    background: transparent;
    text-align: center;
    font-size: 14px;
    color: var(--ka-text);
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .ka-qty__input::-webkit-outer-spin-button,
  .ka-qty__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .ka-item__prices {
    text-align: right;
    font-size: 14px;
    line-height: 1.4;
  }

  .ka-item__compare {
    color: var(--ka-muted);
    text-decoration: line-through;
    margin-right: 8px;
  }

  .ka-item__save {
    margin: 2px 0 0;
    color: var(--ka-save);
    font-weight: 600;
  }

  .ka-cart__empty {
    padding: 40px var(--ka-gutter);
    text-align: center;
  }

  .ka-cart__empty p {
    margin: 0 0 20px;
    font-size: 16px;
  }

  .ka-cart__footer {
    padding: 18px 20px 20px;
  }

  .ka-cart__extras {
    display: grid;
    gap: 6px;
    justify-items: start;
    margin-bottom: 14px;
    font-size: 13px;
  }

  .ka-cart__discounts {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-bottom: 14px;
    font-size: 15px;
  }

  .ka-cart__discount-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ka-cart__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: var(--ka-badge-bg);
    border-radius: 3px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .03em;
    text-transform: uppercase;
    color: var(--ka-text);
  }

  .ka-cart__badge svg {
    width: 12px;
    height: 12px;
    transform: rotate(90deg);
  }

  .ka-cart__discount-amount {
    margin-left: auto;
  }

  .ka-cart__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    min-height: 50px;
    padding: 12px 16px;
    border: 1px solid var(--ka-accent);
    border-radius: {{ s.button_radius }}px;
    background: var(--ka-accent);
    color: var(--ka-accent-text);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: .02em;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
  }

  .ka-cart__btn--secondary {
    background: transparent;
    color: var(--ka-accent);
    margin-bottom: 10px;
  }

  .ka-cart__payments {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  /* Icons stay on one line and shrink evenly on narrow phones */
  .ka-cart__pay {
    display: block;
    flex: 0 1 46px;
    min-width: 0;
    aspect-ratio: 38 / 24;
    padding: 0;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0, 0, 0, .1);
  }

  .ka-cart__pay svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ka-cart .complementary-products {
    padding: 0 var(--ka-gutter) 20px;
  }
{%- endstyle -%}

<cart-drawer id="cart-drawer" class="cart-drawer drawer ka-cart {% if cart.empty? %}drawer--center-body{% endif %} color-scheme color-scheme--{{ s.color_scheme.id }}" data-section-id="{{ section.id }}" initial-focus="false" handle-editor-events>
  <div class="ka-cart__header" slot="header">
    <div class="ka-cart__brand">
      {%- if s.logo != blank -%}
        {{- s.logo | image_url: width: 600 | image_tag: alt: shop.name, loading: 'eager' -}}
      {%- else -%}
        <span class="ka-cart__brand-text">
          <span class="ka-cart__brand-name">{{ shop.name }}</span>
          {%- if s.logo_subtitle != blank -%}<span class="ka-cart__brand-sub">{{ s.logo_subtitle }}</span>{%- endif -%}
        </span>
      {%- endif -%}
    </div>

    {%- if s.show_announcement and s.announcement_text != blank -%}
      <div class="ka-cart__announcement">{{ s.announcement_text }}</div>
    {%- endif -%}

    {%- if s.show_rewards and tier_count > 0 and cart.item_count > 0 -%}
      <div class="ka-rewards">
        {%- if rewards_message != blank -%}
          <p class="ka-rewards__message">{{ rewards_message }}</p>
        {%- endif -%}

        <div class="ka-rewards__track {% if s.show_tier_labels %}has-labels{% endif %}" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ fill | round }}">
          <div class="ka-rewards__rail">
            <div class="ka-rewards__fill" style="width: calc((100% - var(--ka-dot) / 2) * {{ fill | divided_by: 100.0 | round: 4 }});"></div>
          </div>

          {%- for tier in tiers -%}
            {%- assign dot_pos = forloop.index | times: 1.0 | divided_by: tier_count | round: 4 -%}
            <span class="ka-rewards__dot {% if forloop.index <= reached %}is-reached{% endif %}" style="left: calc((100% - var(--ka-dot) / 2) * {{ dot_pos }});" {{ tier.shopify_attributes }}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.4"/></svg>
              {%- if s.show_tier_labels and tier.settings.label != blank -%}
                <span class="ka-rewards__label">{{ tier.settings.label }}</span>
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if cart.empty? -%}
    <div class="ka-cart__empty">
      <p>{{ s.empty_text }}</p>
      {%- if s.empty_button_label != blank -%}
        <a href="{{ s.empty_button_link | default: routes.all_products_collection_url }}" class="ka-cart__btn">{{ s.empty_button_label }}</a>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="ka-cart__error" data-ka-error hidden></div>

    <div class="ka-cart__items">
      {%- for item in cart.items -%}
        {%- liquid
          assign compare_line = 0
          if item.variant.compare_at_price > item.original_price
            assign compare_line = item.variant.compare_at_price | times: item.quantity
          endif
          assign save_amount = compare_line | minus: item.original_line_price

          assign max_quantity = ''
          if item.variant.inventory_management != blank and item.variant.inventory_policy == 'deny'
            assign qty_for_variant = cart | item_count_for_variant: item.variant.id
            assign max_quantity = item.variant.inventory_quantity | minus: qty_for_variant | plus: item.quantity
          endif
        -%}

        {%- liquid
          assign compare_unit = 0
          if item.variant.compare_at_price > item.original_price
            assign compare_unit = item.variant.compare_at_price
          endif
        -%}
        <div class="ka-item" data-key="{{ item.key }}" data-unit="{{ item.original_price }}" data-compare-unit="{{ compare_unit }}" data-max="{{ max_quantity }}">
          <a href="{{ item.url }}" class="ka-item__media">
            {%- if item.image != blank -%}
              {{- item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title -}}
            {%- endif -%}
          </a>

          <div class="ka-item__info">
            <div class="ka-item__top">
              <a href="{{ item.url }}" class="ka-item__title">{{ item.product.title | default: item.title }}</a>

              <button type="button" class="ka-item__remove" data-ka-change="{{ item.key }}" data-ka-qty="0" aria-label="{{ 'cart.order.remove' | t | escape }}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M5 6l1 14a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1l1-14"/><path d="M10 10v7M14 10v7"/></svg>
              </button>
            </div>

            {%- capture item_meta -%}
              {%- if s.show_variant_options -%}
                {%- unless item.product.has_only_default_variant or item.gift_card -%}
                  {%- for option in item.options_with_values -%}
                    <li>{{ option.name }}: {{ option.value }}</li>
                  {%- endfor -%}
                {%- endunless -%}
              {%- endif -%}

              {%- if item.selling_plan_allocation -%}
                <li>{{ item.selling_plan_allocation.selling_plan.name }}</li>
              {%- endif -%}

              {%- for property in item.properties -%}
                {%- assign first_character_in_key = property.first | truncate: 1, '' -%}
                {%- if property.last == blank or first_character_in_key == '_' -%}{%- continue -%}{%- endif -%}
                <li>
                  {%- if property.last contains '/uploads/' -%}
                    <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
                  {%- else -%}
                    {{ property.first }}: {{ property.last }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- endcapture -%}

            {%- if item_meta != blank -%}
              <ul class="ka-item__meta">{{ item_meta }}</ul>
            {%- endif -%}

            <div class="ka-item__bottom">
              <div class="ka-qty">
                <button type="button" class="ka-qty__btn" data-ka-change="{{ item.key }}" data-ka-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'product.quantity.decrease_quantity' | t | escape }}">&minus;</button>
                <input class="ka-qty__input" type="number" inputmode="numeric" min="0" {% if max_quantity != blank %}max="{{ max_quantity | at_least: item.quantity }}"{% endif %} value="{{ item.quantity }}" data-ka-input="{{ item.key }}" aria-label="{{ 'product.quantity.change_quantity' | t | escape }}">
                <button type="button" class="ka-qty__btn" data-ka-change="{{ item.key }}" data-ka-qty="{{ item.quantity | plus: 1 }}" {% if max_quantity != blank and item.quantity >= max_quantity %}disabled{% endif %} aria-label="{{ 'product.quantity.increase_quantity' | t | escape }}">+</button>
              </div>

              <div class="ka-item__prices">
                <div>
                  {%- if compare_line > item.original_line_price -%}
                    <span class="ka-item__compare" data-ka-compare>{{ compare_line | money }}</span>
                  {%- endif -%}
                  <span data-ka-price>{{ item.original_line_price | money }}</span>
                </div>

                {%- if s.show_savings and save_amount > 0 -%}
                  {%- assign save_money = save_amount | money -%}
                  <p class="ka-item__save" data-ka-save data-template="{{ s.savings_text | escape }}">{{ s.savings_text | replace: '[amount]', save_money }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- liquid
      assign cross_sell_products_count = 0

      for product in s.cross_sell_products
        assign products_in_cart = cart.items | where: 'product_id', product.id

        if products_in_cart.size == 0 and product.available
          assign cross_sell_products_count = cross_sell_products_count | plus: 1
        endif
      endfor
    -%}

    {%- if cross_sell_products_count > 0 -%}
      <div class="cart-drawer__complementary-products complementary-products">
        {%- assign carousel_id = 'complementary-products-carousel-' | append: section.id -%}

        {%- if s.cross_sell_title != blank or s.cross_sell_stack_products == false and cross_sell_products_count > 1 -%}
          <div class="complementary-products__header complementary-products__header--align-start">
            <p class="h6">{{ s.cross_sell_title }}</p>

            {%- if s.cross_sell_stack_products == false and cross_sell_products_count > 1 -%}
              <carousel-navigation aria-controls="{{ carousel_id }}" class="page-dots page-dots--narrow">
                {%- for i in (1..cross_sell_products_count) -%}
                  <button class="relative" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                    <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
                  </button>
                {%- endfor -%}
              </carousel-navigation>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- liquid
          capture complementary_products
            for product in s.cross_sell_products
              assign products_in_cart = cart.items | where: 'product_id', product.id

              if products_in_cart.size == 0 and product.available
                render 'product-card-horizontal', product: product, show_quick_buy: true
              endif
            endfor
          endcapture
        -%}

        {%- if s.cross_sell_stack_products -%}
          <div class="complementary-products__product-list">
            {{- complementary_products -}}
          </div>
        {%- else -%}
          <scroll-carousel id="{{ carousel_id }}" class="complementary-products__product-list complementary-products__product-list--carousel scroll-area snap-x">
            {{- complementary_products -}}
          </scroll-carousel>
        {%- endif -%}
      </div>
    {%- endif -%}

    <form action="{{ routes.cart_url }}" method="POST" class="ka-cart__footer" slot="footer">
      <input type="hidden" name="attributes[products_mobile_grid_mode]" value="">
      <input type="hidden" name="attributes[products_desktop_grid_mode]" value="">

      {%- if s.show_cart_note or s.show_shipping_text -%}
        <div class="ka-cart__extras">
          {%- if s.show_cart_note -%}
            {%- assign cart_note_dialog_id = 'cart-note-' | append: section.id -%}
            <button type="button" class="link-faded-reverse" aria-controls="{{ cart_note_dialog_id }}">{{ 'cart.general.add_order_note' | t }}</button>

            <cart-note-dialog id="{{ cart_note_dialog_id }}" class="cart-drawer__order-note">
              <div class="form">
                <cart-note class="form-control">
                  {%- assign order_note = 'cart.general.order_note' | t -%}
                  {%- assign placeholder = 'cart.general.note_placeholder' | t -%}
                  {%- render 'input', name: 'note', multiline: 3, label: order_note, value: cart.note, placeholder: placeholder, show_label_as_block: true -%}
                </cart-note>

                <button type="button" class="button" is="dialog-close-button">{{ 'cart.general.save_note' | t }}</button>
              </div>
            </cart-note-dialog>
          {%- endif -%}

          {%- if s.show_shipping_text -%}
            <p class="text-subdued">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.show_discounts and cart.total_discount > 0 -%}
        <div class="ka-cart__discounts">
          <span>{{ s.discounts_label }}</span>

          <div class="ka-cart__discount-badges">
            {%- if s.use_tier_badge and last_tier != nil and last_tier.settings.badge_text != blank -%}
              <span class="ka-cart__badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.4"/></svg>
                {{- last_tier.settings.badge_text -}}
              </span>
            {%- else -%}
              {%- for discount_application in cart.discount_applications -%}
                <span class="ka-cart__badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.4"/></svg>
                  {{- discount_application.title -}}
                </span>
              {%- endfor -%}
            {%- endif -%}
          </div>

          <span class="ka-cart__discount-amount">- {{ cart.total_discount | money }}</span>
        </div>
      {%- endif -%}

      {%- if s.show_view_cart_button or s.show_checkout_button == false -%}
        <a href="{{ routes.cart_url }}" class="ka-cart__btn ka-cart__btn--secondary">{{ 'cart.general.view_cart' | t }}</a>
      {%- endif -%}

      {%- if s.show_checkout_button -%}
        <button type="submit" name="checkout" class="ka-cart__btn">
          {{- s.checkout_label -}}
          {%- if s.show_price_in_checkout_button %}<span>&bull;</span><span class="ka-cart__btn-total">{{ cart.total_price | money }}</span>{%- endif -%}
        </button>
      {%- endif -%}

      {%- if s.show_payment_icons -%}
        {%- liquid
          if s.payment_icons != blank
            assign pay_types = s.payment_icons | remove: ' ' | split: ','
          else
            assign pay_types = shop.enabled_payment_types
          endif
        -%}
        <div class="ka-cart__payments">
