{{ 'hz-watch-shop.css' | asset_url | stylesheet_tag }}

<section class="hz-watch" aria-labelledby="HzWatchTitle-{{ section.id }}">
  <div class="hz-watch__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hz-watch__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="hz-watch__title" id="HzWatchTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </div>

  <div class="hz-watch__grid">
    {%- for block in section.blocks -%}
      <article class="hz-watch__card" {{ block.shopify_attributes }}>
        <div class="hz-watch__media">
          {%- if block.settings.video_url != blank -%}
            <video
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 }}{% endif %}"
            >
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>
          {%- elsif block.settings.image != blank -%}
            {%- assign tile_alt = block.settings.title | default: block.settings.image.alt -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                decoding: 'async',
                widths: '480, 720, 960, 1200',
                sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 100vw',
                alt: tile_alt
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="hz-watch__shade" aria-hidden="true"></div>
        <div class="hz-watch__content">
          {%- if block.settings.title != blank -%}
            <h3 class="hz-watch__card-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a
              class="hz-watch__cta"
              {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
            >
              {{ block.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "HZ watch and shop",
  "tag": "section",
  "class": "section-hz-watch-shop-grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MEN · WOMEN · SMART" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch & Shop" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Media tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image / poster" },
        { "type": "text", "id": "video_url", "label": "MP4 video URL", "info": "Host your own MP4. Do not use competitor brand videos." },
        { "type": "text", "id": "title", "label": "Title", "default": "Classic Quartz" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Quartz" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HZ watch and shop",
      "blocks": [
        { "type": "tile", "settings": { "title": "Classic Quartz", "button_label": "Shop Quartz" } },
        { "type": "tile", "settings": { "title": "Men's Quartz", "button_label": "Shop Men" } },
        { "type": "tile", "settings": { "title": "Elite Quartz", "button_label": "Shop Elite" } },
        { "type": "tile", "settings": { "title": "Shop Smart", "button_label": "Shop Smart" } },
        { "type": "tile", "settings": { "title": "Women's Quartz", "button_label": "Shop Women" } },
        { "type": "tile", "settings": { "title": "Couple Sets", "button_label": "Shop Couples" } }
      ]
    }
  ]
}
{% endschema %}
