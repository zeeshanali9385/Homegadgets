{% comment %}
  Section: Icon + Text List (Vntura)
  Usage: Add this section to your homepage or any template. Edit items and pick icons in the customizer.
{% endcomment %}

<section class="vnt-icon-text">
  <div class="vnt-icon-text__wrap page-width">
    <ul class="vnt-icon-text__list">
      {%- for block in section.blocks -%}
        <li class="vnt-icon-text__item" {{ block.shopify_attributes }}>
          <span class="vnt-icon-text__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <!-- Truck -->
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M3 5h11v9h2.5a2 2 0 0 0 1.8-1.1l1.2-2.4A2 2 0 0 0 19.7 8H17V5h2.7a2 2 0 0 1 1.8 1.1l1.8 3.6A2 2 0 0 1 22.6 12H21v2a2 2 0 0 1-2 2h-1a2.75 2.75 0 1 1-5.5 0H9.5a2.75 2.75 0 1 1-5.5 0H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm3 12.75A1.75 1.75 0 1 0 7.75 16 1.75 1.75 0 0 0 6 17.75Zm9 0A1.75 1.75 0 1 0 16.75 16 1.75 1.75 0 0 0 15 17.75Z"/></svg>
              {%- when 'return' -%}
                <!-- Return/Loop -->
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M7 7V3L1 9l6 6v-4h7a4 4 0 1 1 0 8H6v2h8a6 6 0 1 0 0-12H7Z"/></svg>
              {%- when 'gift' -%}
                <!-- Gift -->
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20 7h-2.1A3.5 3.5 0 0 0 12 4.6 3.5 3.5 0 0 0 6.1 7H4a1 1 0 0 0-1 1v3h9V8h2v3h9V8a1 1 0 0 0-1-1Zm-9 12H4a1 1 0 0 1-1-1v-7h8v8Zm2 0v-8h8v7a1 1 0 0 1-1 1h-7ZM8 7a1.5 1.5 0 0 1 3 0v1H8.9A1.9 1.9 0 0 1 8 7Zm8 0a1.9 1.9 0 0 1-.9 1H13V7a1.5 1.5 0 0 1 3 0Z"/></svg>
              {%- when 'payment' -%}
                <!-- Payment/Shield -->
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2 4 5v6c0 4.6 3.1 8.8 8 10 4.9-1.2 8-5.4 8-10V5l-8-3Zm0 17a7.6 7.6 0 0 1-6-7V6.3l6-2.2 6 2.2V12a7.6 7.6 0 0 1-6 7Z"/></svg>
              {%- else -%}
                <!-- Dot -->
                <svg viewBox="0 0 24 24" width="8" height="8" fill="currentColor"><circle cx="12" cy="12" r="4"/></svg>
            {%- endcase -%}
          </span>
          <span class="vnt-icon-text__text">{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <style>
    .vnt-icon-text { background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; }
    .vnt-icon-text__wrap { padding: {{ section.settings.padding_y }} {{ section.settings.padding_x }}; }
    .vnt-icon-text__list { display:flex; flex-wrap:wrap; gap: {{ section.settings.gap }}; align-items:center; justify-content:center; margin:0; padding:0; list-style:none; }
    .vnt-icon-text__item { display:flex; align-items:center; gap:.5rem; font-size: {{ section.settings.font_size }}; line-height:1.4; }
    .vnt-icon-text__icon { display:inline-flex; }
    @media (max-width: 640px){
      .vnt-icon-text__item { flex: 1 1 100%; justify-content: center; }
    }
  </style>
</section>

{% schema %}
{
  "name": "Icon + Text List",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "text", "id": "padding_y", "label": "Vertical padding", "default": "12px" },
    { "type": "text", "id": "padding_x", "label": "Horizontal padding", "default": "0" },
    { "type": "text", "id": "gap", "label": "Item gap", "default": "20px" },
    { "type": "text", "id": "font_size", "label": "Font size", "default": "14px" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Shipping truck" },
            { "value": "return", "label": "Easy returns" },
            { "value": "gift", "label": "Gift/Discount" },
            { "value": "payment", "label": "Secure payment" },
            { "value": "dot", "label": "Minimal dot" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Gratis Versand innerhalb der Schweiz"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Icon + Text List",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "text": "Gratis Versand, 30-Tage Rückgabe" } },
        { "type": "item", "settings": { "icon": "gift", "text": "Extra-Rabatt beim Kauf von 2+ Produkten" } },
        { "type": "item", "settings": { "icon": "payment", "text": "Einfach & sicher mit TWINT zahlen" } }
      ]
    }
  ]
}
{% endschema %}
