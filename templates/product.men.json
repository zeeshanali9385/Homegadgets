        "liquid_C9aEMy": {
          "type": "liquid",
          "disabled": true,
          "settings": {
            "liquid": "<!-- STANDALONE QUANTITY DISCOUNT BADGE - Just paste this anywhere on your page -->\n\n<style>\n  .qty-discount-container {\n    margin: 10px 0;\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n  }\n  \n  .qty-discount-badge {\n    background: #1a1a1a;\n    color: #fff;\n    border: 1px solid #1a1a1a;\n    padding: 6px 14px;\n    border-radius: 20px;\n    font-size: 13px;\n    font-weight: 500;\n    cursor: pointer;\n    transition: all 0.2s ease;\n    text-decoration: none;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    border: none;\n    outline: none;\n  }\n  \n  .qty-discount-badge:hover {\n    background: #333;\n    transform: translateX(2px);\n  }\n  \n  .qty-toggle-arrow {\n    display: inline-block;\n    transition: transform 0.3s ease;\n    font-size: 10px;\n  }\n  \n  .qty-discount-badge.active .qty-toggle-arrow {\n    transform: rotate(90deg);\n  }\n  \n  .qty-discount-info {\n    background: #f8f8f8;\n    border-left: 3px solid #1a1a1a;\n    padding: 12px 15px;\n    margin-top: 10px;\n    border-radius: 0 4px 4px 0;\n    font-size: 13px;\n    line-height: 1.6;\n    display: none;\n    animation: slideIn 0.3s ease;\n    max-width: 280px;\n  }\n  \n  .qty-discount-info.show {\n    display: block;\n  }\n  \n  .saison-aktion-text {\n    color: #e65100;\n    font-weight: 600;\n    margin-bottom: 8px;\n    font-size: 13px;\n  }\n  \n  .qty-tier {\n    padding: 3px 0;\n    color: #333;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  \n  .qty-tier-amount {\n    font-weight: 600;\n    color: #1a1a1a;\n    min-width: 70px;\n  }\n  \n  .qty-tier-discount {\n    color: #d32f2f;\n    font-weight: 500;\n  }\n  \n  @keyframes slideIn {\n    from {\n      opacity: 0;\n      transform: translateY(-10px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n</style>\n\n<div class=\"qty-discount-container\">\n  <button class=\"qty-discount-badge\" onclick=\"toggleQtyDiscount(event)\">\n    <span>Zusätzlich bis zu 30% bei Mehrfachkauf</span>\n    <span class=\"qty-toggle-arrow\">▶</span>\n  </button>\n  \n  <div class=\"qty-discount-info\" id=\"qtyDiscountInfo\">\n    <div class=\"saison-aktion-text\">✓ Saison Aktion berechtigt</div>\n    <div class=\"qty-tier\">\n      <span class=\"qty-tier-amount\">2 Artikel</span>\n      <span class=\"qty-tier-discount\">= Extra 20%</span>\n    </div>\n    <div class=\"qty-tier\">\n      <span class=\"qty-tier-amount\">3 Artikel</span>\n      <span class=\"qty-tier-discount\">= Extra 25%</span>\n    </div>\n    <div class=\"qty-tier\">\n      <span class=\"qty-tier-amount\">4+ Artikel</span>\n      <span class=\"qty-tier-discount\">= Extra 30%</span>\n    </div>\n  </div>\n</div>\n\n<script>\n  function toggleQtyDiscount(event) {\n    event.preventDefault();\n    const button = event.currentTarget;\n    const info = document.getElementById('qtyDiscountInfo');\n    \n    button.classList.toggle('active');\n    info.classList.toggle('show');\n  }\n</script>"
          }
