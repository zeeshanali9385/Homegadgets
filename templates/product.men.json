          "settings": {
            "liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Product Features</title>\n    <style>\n      /* ===== FONT SIZE & WEIGHT CONTROL ===== */\n      /* Change these two values to adjust globally */\n      .vnt-feature-stack {\n        --feature-font-size: 16px;   /* << Adjust font size here */\n        --feature-font-weight: 500;  /* << Adjust font boldness here */\n      }\n      .vnt-feature-stack {\n        display: grid;\n        gap: 2px;\n        margin: 0px 0 0;\n      }\n      .vnt-feature-item {\n        display: inline-flex;\n        align-items: center;\n        gap: 8px;\n        line-height: 1.35;\n        font-size: var(--feature-font-size);     \n        font-weight: var(--feature-font-weight); \n      }\n      .vnt-feature-item img {\n        width: 20px;\n        height: 20px;\n        display: block;\n      }\n      .vnt-feature-item svg {\n        width: 15px;\n        height: 15px;\n        display: block;\n      }\n    </style>\n</head>\n<body>\n    <div class=\"vnt-feature-stack\">\n      <!-- LINE 1 -->\n      <div class=\"vnt-feature-item\">\n        <span class=\"icon\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0939/2036/2831/files/rmg_logo.svg?v=1754638185\" alt=\"Free Shipping with Royal Mail\">\n        </span>\n        <span>Free Shipping with Royal Mail</span>\n      </div>\n      <!-- LINE 2 -->\n      <div class=\"vnt-feature-item\">\n        <span class=\"icon\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0913/7199/5520/files/RETURNS_ICON_SMALLR.svg?v=1754693587\" alt=\"Rückgaberecht\">\n        </span>\n        <span>30 Day Return Period</span>\n      </div>\n      <!-- LINE 3 - FIXED -->\n      <div class=\"vnt-feature-item\">\n        <span class=\"icon\">\n          <svg width=\"15\" height=\"15\" aria-hidden=\"true\">\n            <circle cx=\"7.5\" cy=\"7.5\" r=\"7.