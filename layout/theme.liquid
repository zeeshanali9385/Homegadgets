<!doctype html> 

<style>
/* Desktop-only improvements for text-with-icons section */
@media screen and (min-width: 999px) {
  /* Match multi-column container width and spacing */
  .shopify-section--text-with-icons .ms-icon-text {
    --desktop-item-gap: 4.375rem; /* Medium spacing to match multi-column */
  }
  
  /* Adjust the text-with-icons container on desktop */
  .shopify-section--text-with-icons .text-with-icons:not(.text-with-icons--stacked) {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--desktop-item-gap);
    overflow: visible !important;
  }
  
  /* Remove carousel behavior on desktop */
  .shopify-section--text-with-icons text-with-icons-carousel[disabled-on="sm"] {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--desktop-item-gap);
    overflow: visible !important;
  }
  
  /* Ensure items take full width of their grid cell */
  .shopify-section--text-with-icons .text-with-icons__item {
    width: 100% !important;
    max-width: none !important;
    flex: none !important;
  }
  
  /* Optional: Add configurable columns (2, 3, or 4 columns) */
  .shopify-section--text-with-icons[data-columns="2"] .text-with-icons:not(.text-with-icons--stacked),
  .shopify-section--text-with-icons[data-columns="2"] text-with-icons-carousel[disabled-on="sm"] {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .shopify-section--text-with-icons[data-columns="4"] .text-with-icons:not(.text-with-icons--stacked),
  .shopify-section--text-with-icons[data-columns="4"] text-with-icons-carousel[disabled-on="sm"] {
    grid-template-columns: repeat(4, 1fr);
  }
  
  /* Fine-tune spacing options */
  .shopify-section--text-with-icons[data-spacing="xs"] {
    --desktop-item-gap: 1.875rem;
  }
  
  .shopify-section--text-with-icons[data-spacing="sm"] {
    --desktop-item-gap: 3.125rem;
  }
  
  .shopify-section--text-with-icons[data-spacing="md"] {
    --desktop-item-gap: 4.375rem;
  }
  
  .shopify-section--text-with-icons[data-spacing="lg"] {
    --desktop-item-gap: 5.625rem;
  }
}

/* Maintain mobile carousel behavior */
@media screen and (max-width: 998px) {
  /* Keep existing mobile behavior intact */
  .shopify-section--text-with-icons .text-with-icons {
    /* Preserve carousel/swipe functionality */
  }
}
</style>

