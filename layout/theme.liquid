    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
    <style>
      .ms-color-swatch-grid ul {
        gap: {{ settings.gap_swatch_mob }}px;
      }
      .ms-color-swatch-grid ul li img {
        width: {{ settings.swatch_size_mob }}px;
        min-width: {{ settings.swatch_size_mob }}px;
        height: {{ settings.swatch_size_mob }}px;
      }
      .ms-color-swatch-grid ul li span {
        font-weight: bold;
      }
      @media (min-width: 1024px) {
        .ms-color-swatch-grid ul {
          gap: {{ settings.gap_swatch_desk }}px;
        }
        .ms-color-swatch-grid ul li,
        .ms-color-swatch-grid ul li img {
          width: {{ settings.swatch_size_desk }}px;
          min-width: {{ settings.swatch_size_desk }}px;
          height: {{ settings.swatch_size_desk }}px;
        }
      }
    </style>

     <script src="https://kit.fontawesome.com/9cb23dc698.js" crossorigin="anonymous"></script>
    
