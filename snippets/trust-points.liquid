{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
TRUST POINTS
----------------------------------------------------------------------------------------------------------------------
Vertical list of icon + text rows for the product page (Wilson & Carter style).
Falls back to built-in SVG icons when no image is uploaded.
{%- endcomment -%}

{%- liquid
  assign icon_size = block.settings.icon_size | default: 18
  assign font_size = block.settings.font_size | default: 14
  assign text_color = block.settings.text_color | default: '#000000'
-%}

<div class="trust-points" style="--trust-icon-size: {{ icon_size }}px; --trust-font-size: {{ font_size }}px; --trust-text-color: {{ text_color }};">
  {%- for i in (1..3) -%}
    {%- liquid
      case i
        when 1
          assign point_image = block.settings.image_1
          assign point_text = block.settings.text_1
          assign fallback_icon = 'truck'
        when 2
          assign point_image = block.settings.image_2
          assign point_text = block.settings.text_2
          assign fallback_icon = 'return'
        when 3
          assign point_image = block.settings.image_3
          assign point_text = block.settings.text_3
          assign fallback_icon = 'tag'
      endcase
    -%}

    {%- if point_text != blank or point_image != blank -%}
      <div class="trust-points__item">
        <span class="trust-points__icon" aria-hidden="true">
          {%- if point_image != blank -%}
            {%- capture icon_sizes -%}{{ icon_size }}px{%- endcapture -%}
            {{- point_image | image_url: width: 80 | image_tag: loading: 'lazy', widths: '36,54,72,80', sizes: icon_sizes, alt: '' -}}
          {%- else -%}
            {%- case fallback_icon -%}
              {%- when 'truck' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="13" height="10" rx="1"/><path d="M14 9h4l3 3v4h-7V9z"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
              {%- when 'return' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><polyline points="3 4 3 9 8 9"/></svg>
              {%- when 'tag' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 12.1 21.9a2 2 0 0 1-2.8 0L2.2 14.8a2 2 0 0 1 0-2.8L10.7 3.5a2 2 0 0 1 1.4-.6H20v7.9a2 2 0 0 1-.4 1.2z"/><circle cx="16" cy="8" r="1.2"/></svg>
            {%- endcase -%}
          {%- endif -%}
        </span>
        {%- if point_text != blank -%}
          <span class="trust-points__text">{{ point_text | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>
